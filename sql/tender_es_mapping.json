{
  "settings": {
    "number_of_shards": 6,
    "number_of_replicas": 1,
    "analysis": {
      "analyzer": {
        "ik_smart_search": { "type": "custom", "tokenizer": "ik_smart" },
        "ik_max_search": { "type": "custom", "tokenizer": "ik_max_word" }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": { "type": "long" },
      "title": { "type": "text", "analyzer": "ik_max_search", "search_analyzer": "ik_smart_search", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
      "project_code": { "type": "keyword" },
      "notice_type": { "type": "keyword" },
      "purchaser": { "type": "text", "analyzer": "ik_max_search", "fields": { "keyword": { "type": "keyword" } } },
      "supplier_names": { "type": "text", "analyzer": "ik_max_search" },
      "province": { "type": "keyword" },
      "city": { "type": "keyword" },
      "amount": { "type": "scaled_float", "scaling_factor": 100 },
      "published_at": { "type": "date", "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||yyyy-MM-dd" },
      "deadline": { "type": "date", "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||yyyy-MM-dd" },
      "source_name": { "type": "keyword" },
      "is_matched": { "type": "boolean" },
      "tags": { "type": "keyword" }
    }
  }
}
